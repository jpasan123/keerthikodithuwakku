# Brevo transactional email — set these in Vercel, never commit real values.
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=verified-sender@your-domain.com
BREVO_SENDER_NAME=Keerthi Kodithuwakku Website

# Optional. Defaults to keerthi@jendoinnovations.com (site.email) when omitted.
BREVO_TO_EMAIL=keerthi@jendoinnovations.com

# Google Analytics 4 — Measurement ID (e.g. G-6QZWNTQ711).
# Vercel: GA_MEASUREMENT_ID or NEXT_PUBLIC_GA_MEASUREMENT_ID (same value).
# GA4 dashboard: Reports → Engagement → Pages and screens (views per page).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AI Studio (Gemini) — free tier key for the site chatbot.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-2.0-flash-lite (good free-tier volume).
GEMINI_MODEL=gemini-2.0-flash-lite
