# /etc/nginx/sites-available/keerthi-kodithuwakku-web
# Until domain is ready: listen on server IP + port 8081, or use path below on :80

upstream keerthi_web {
    server 127.0.0.1:3001;
    keepalive 32;
}

# Option A — IP + port (preview before domain)
server {
    listen 8081;
    server_name _;

    location / {
        proxy_pass http://keerthi_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

